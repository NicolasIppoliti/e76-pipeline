{
  "name": "e76-pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/unit.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration.test.ts",
    "check": "npm run build && npm test",
    "db:setup": "tsx src/cli.ts setup",
    "ingest": "tsx src/cli.ts ingest",
    "status": "tsx src/cli.ts status",
    "report": "tsx src/cli.ts report"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
